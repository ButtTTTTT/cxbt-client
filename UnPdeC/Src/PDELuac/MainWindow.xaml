<Window x:Class="PDELuac.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDE Luac v1.0.0" Height="600" Width="480"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 根目录设置（必填） -->
        <GroupBox Grid.Row="0" Header="根目录（必填）" Margin="0,0,0,15" Padding="10"
                  x:Name="grpRootPath">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="txtRootPath" VerticalAlignment="Center" Padding="5"
                         TextChanged="TxtRootPath_TextChanged" FontFamily="Consolas"/>
                <Button Grid.Column="1" Content="浏览..." VerticalAlignment="Center" Margin="10,0,0,0" 
                        Padding="15,5" Click="BtnBrowseRoot_Click"/>
            </Grid>
            <GroupBox.Style>
                <Style TargetType="GroupBox">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tag, ElementName=grpRootPath}" Value="Invalid">
                            <Setter Property="BorderBrush" Value="Red"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </GroupBox.Style>
        </GroupBox>

        <!-- 拖放区域 -->
        <Border Grid.Row="1" BorderBrush="#2196F3" BorderThickness="2" Background="#E3F2FD" 
                CornerRadius="10" MouseLeftButtonUp="DropZone_Click" Cursor="Hand" 
                Height="120" Margin="0,0,0,15">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="[DROP ZONE]" FontSize="24" HorizontalAlignment="Center" 
                           FontWeight="Bold" Foreground="#2196F3"/>
                <TextBlock Text="拖入 .lua 文件或文件夹" FontSize="14" HorizontalAlignment="Center" 
                           Margin="0,5,0,0" Foreground="#666"/>
                <TextBlock x:Name="StatusText" Text="" FontSize="12" HorizontalAlignment="Center" 
                           Margin="0,5,0,0" Foreground="#4CAF50"/>
            </StackPanel>
        </Border>

        <!-- 日志区域 -->
        <GroupBox Grid.Row="2" Header="参数/日志" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- PDE头部选项 -->
                <Grid Grid.Row="0" Margin="0,0,0,8" Background="#F5F5F5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="魔数:" VerticalAlignment="Center" Margin="0,5,5,5"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtMagicNumber" Text="010A0000" 
                             VerticalAlignment="Center" Padding="3" FontFamily="Consolas" Width="80"
                             HorizontalAlignment="Left" Margin="0,5,15,5"
                             ToolTip="4字节魔数，十六进制格式"/>
                    <CheckBox Grid.Row="0" Grid.Column="2" x:Name="chkAddPDEHeader" 
                              Content="添加 魔数+大小" VerticalAlignment="Center" IsChecked="True"
                              ToolTip="在 .luac 文件前添加自定义头部"
                              Checked="ChkAddPDEHeader_Changed" Unchecked="ChkAddPDEHeader_Changed"/>


                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" x:Name="txtPDEInfo"
                               FontSize="11" Foreground="#666" Margin="0,0,0,5">
                        <Run>勾选时: </Run>
                        <Run Foreground="#2196F3">[魔数 4B]+[Lua字节码大小 4B]+[Lua字节码]</Run>
                        <Run> |  不勾选: </Run>
                        <Run Foreground="#FF9800">[Lua字节码]</Run>
                    </TextBlock>
                </Grid>

                <!-- 日志文本框 -->
                <RichTextBox Grid.Row="1" x:Name="rtbLog" IsReadOnly="True" 
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" 
                             FontFamily="Consolas" FontSize="11"
                             Background="#FAFAFA" BorderBrush="#DDD">
                    <RichTextBox.Document>
                        <FlowDocument/>
                    </RichTextBox.Document>
                </RichTextBox>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
