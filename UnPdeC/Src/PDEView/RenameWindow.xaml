<Window x:Class="PDEView.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名" Height="200" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FF6A00"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#CC5500"/>
        <SolidColorBrush x:Key="TextBrush" Color="#333333"/>
        <SolidColorBrush x:Key="GrayBrush" Color="#666666"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="输入新名称：" Margin="0,0,0,10" 
                   FontSize="14" Foreground="{StaticResource TextBrush}" FontWeight="Medium"/>

        <TextBox Grid.Row="1" x:Name="NameTextBox" 
                 Padding="10,8" 
                 FontSize="14"
                 Margin="0,0,0,20"
                 Background="White"
                 BorderBrush="{StaticResource BorderBrush}"
                 BorderThickness="1"
                 KeyDown="NameTextBox_KeyDown"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Width="80" Padding="8" Margin="0,0,10,0"
                    Click="OkButton_Click" IsDefault="True"
                    Background="{StaticResource PrimaryBrush}" Foreground="White"
                    BorderThickness="0" Cursor="Hand" FontSize="13" FontWeight="Medium"/>
            <Button Content="取消" Width="80" Padding="8"
                    Click="CancelButton_Click" IsCancel="True"
                    Background="White" Foreground="{StaticResource GrayBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Cursor="Hand" FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>
