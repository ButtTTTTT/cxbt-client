<Page x:Class="PDEKit.Pages.AnalysisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:converters="clr-namespace:PDEKit.Converters"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="850"
      Title="分析">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">
            <!-- 页面标题 -->
            <TextBlock Text="PDE 分析工具" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="文件特征分析、CRC 校验、VFS 表导出"
                       Style="{StaticResource PageSubtitleStyle}" />

            <!-- FlagFinder 卡片 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="4" Padding="6" Margin="0,0,10,0">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="特征分析 (FlagFinder)" Style="{StaticResource CardTitleStyle}" />
                    </StackPanel>
                    <TextBlock Text="扫描目录中的 .cache 文件，分析 0x18 偏移处的标志位（6D/6E/6F）"
                               Style="{StaticResource DescriptionTextStyle}" />

                    <TextBlock Text="扫描模式" Style="{StaticResource LabelTextStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton Content="Cache 模式" GroupName="FlagMode" IsChecked="True"
                                     Margin="0,0,20,0" />
                        <RadioButton Content="Decompress 模式" GroupName="FlagMode" />
                    </StackPanel>

                    <TextBlock Text="扫描目录" Style="{StaticResource LabelTextStyle}" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FlagInputDir" Grid.Column="0"
                                 converters:Watermark.Text="拖入目录..."
                                 IsReadOnly="True"
                                 Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="浏览"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>

                    <Button Content="&#xE72C;  开始扫描"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- VerifyCRC 卡片 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="4" Padding="6" Margin="0,0,10,0">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="CRC 校验 (VerifyCRC)" Style="{StaticResource CardTitleStyle}" />
                    </StackPanel>
                    <TextBlock Text="计算并验证 .cache 文件中的 CRC32 校验码"
                               Style="{StaticResource DescriptionTextStyle}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CrcInputPath" Grid.Column="0"
                                 converters:Watermark.Text="拖入 .cache 文件..."
                                 IsReadOnly="True"
                                 Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="浏览"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- VFS 表导出卡片 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="4" Padding="6" Margin="0,0,10,0">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="VFS 表导出" Style="{StaticResource CardTitleStyle}" />
                    </StackPanel>
                    <TextBlock Text="从 .xor 文件中提取 VFS 表数据"
                               Style="{StaticResource DescriptionTextStyle}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="VfsInputPath" Grid.Column="0"
                                 converters:Watermark.Text="拖入 .xor 文件..."
                                 IsReadOnly="True"
                                 Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="浏览"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
