<Window x:Class="PDEKit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PDEKit" Height="720" Width="1100"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航面板 -->
        <Border Grid.Column="0"
                Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                Width="240"
                Margin="8,8,0,8"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />  <!-- Logo/Title -->
                    <RowDefinition Height="*" />     <!-- Main Nav -->
                    <RowDefinition Height="Auto" />  <!-- Bottom Nav -->
                </Grid.RowDefinitions>

                <!-- 应用标题区 -->
                <StackPanel Grid.Row="0" Margin="20,20,20,12">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="6"
                                Margin="0,0,12,0">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PDEKit" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="PDE 资源工具集" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Separator Grid.Row="0" VerticalAlignment="Bottom"
                           Margin="16,0,16,0"
                           Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <!-- 主导航项 -->
                <StackPanel Grid.Row="1" Margin="8,12,8,0">
                    <RadioButton x:Name="NavUnpack" Style="{StaticResource NavItemStyle}" IsChecked="True"
                                 Click="NavRadioButton_Click" Tag="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="解包" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavPack" Style="{StaticResource NavItemStyle}"
                                 Click="NavRadioButton_Click" Tag="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="打包" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavViewer" Style="{StaticResource NavItemStyle}"
                                 Click="NavRadioButton_Click" Tag="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="浏览" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavAnalysis" Style="{StaticResource NavItemStyle}"
                                 Click="NavRadioButton_Click" Tag="3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="分析" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- 底部导航项 -->
                <StackPanel Grid.Row="2" Margin="8,0,8,8">
                    <Separator Margin="8,0,8,8"
                               Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                    <RadioButton x:Name="NavLog" Style="{StaticResource NavBottomItemStyle}"
                                 Click="NavRadioButton_Click" Tag="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="日志" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右侧内容区 -->
        <Border Grid.Column="1"
                Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                Margin="0,8,8,8"
                CornerRadius="8">
            <Frame x:Name="ContentFrame"
                   NavigationUIVisibility="Hidden"
                   Margin="0" />
        </Border>
    </Grid>
</Window>
