<Window x:Class="PDEPack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDE 打包工具" Height="300" Width="400"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="#2196F3" BorderThickness="2" Background="#E3F2FD" CornerRadius="10" MouseLeftButtonUp="DropZone_Click" Cursor="Hand">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="[拖放区域]" FontSize="24" HorizontalAlignment="Center"/>
                <TextBlock Text="拖拽文件夹到此处，或点击选择" FontSize="14" HorizontalAlignment="Center" Margin="0,10,0,0" Foreground="#666"/>
                <TextBlock x:Name="StatusText" Text="" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="#4CAF50"/>
            </StackPanel>
        </Border>
        <ProgressBar x:Name="ProgressBar" Grid.Row="1" Height="6" Margin="0,15,0,0" Visibility="Collapsed"/>
        <TextBlock Grid.Row="2" Text="输出：文件夹名.pde" FontSize="11" Foreground="#999" HorizontalAlignment="Center" Margin="0,10,0,0"/>
    </Grid>
</Window>
